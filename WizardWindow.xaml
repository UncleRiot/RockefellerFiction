<Window x:Class="RockefellerFiction.WizardWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RockefellerFiction Wizard"
 Width="820"
 Height="650"
 MinWidth="720"
 MinHeight="560"
 WindowStartupLocation="CenterOwner"
 Background="{StaticResource BgBrush}"
 Foreground="{StaticResource TextBrush}">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Design.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>

 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="18"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="72"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

   <Image Source="Resources/Wizard.png"
          Width="60"
          Height="60"
          Stretch="Uniform"
          VerticalAlignment="Top"/>

   <StackPanel Grid.Column="1">
    <TextBlock x:Name="PhaseText"
               Foreground="{StaticResource MutedTextBrush}"
               FontSize="13"/>
    <Grid Margin="0,6,0,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <ProgressBar x:Name="Progress"
                  Height="8"
                  Minimum="0"
                  Maximum="100"
                  Foreground="{StaticResource AccentBrush}"/>
     <TextBlock x:Name="ProgressText"
                Grid.Column="1"
                Margin="12,-5,0,0"
                Foreground="{StaticResource MutedTextBrush}"/>
    </Grid>
   </StackPanel>
  </Grid>

  <StackPanel Grid.Row="2">
   <TextBlock x:Name="QuestionTitle"
              FontSize="24"
              FontWeight="SemiBold"
              Foreground="{StaticResource TextBrush}"
              TextWrapping="Wrap"/>

   <TextBlock x:Name="ExplanationText"
              Margin="0,12,0,0"
              FontSize="15"
              LineHeight="22"
              Foreground="{StaticResource TextBrush}"
              TextWrapping="Wrap"/>
  </StackPanel>

  <ScrollViewer Grid.Row="4"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border x:Name="WherePanel"
            BorderBrush="{StaticResource MutedTextBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12"
            Margin="0,0,0,16">
     <StackPanel>
      <TextBlock Text="Wo finde ich den Wert?"
                 Foreground="{StaticResource AccentBrush}"
                 FontWeight="SemiBold"/>
      <TextBlock x:Name="WhereText"
                 Margin="0,6,0,0"
                 Foreground="{StaticResource TextBrush}"
                 TextWrapping="Wrap"
                 LineHeight="20"/>
     </StackPanel>
    </Border>

    <ContentControl x:Name="InputHost"/>

    <TextBlock x:Name="StandardHintText"
               Margin="0,8,0,0"
               Foreground="{StaticResource AccentBrush}"
               FontWeight="SemiBold"
               TextWrapping="Wrap"/>

    <TextBlock x:Name="ErrorText"
               Margin="0,10,0,0"
               Foreground="{StaticResource DangerBrush}"
               FontWeight="SemiBold"
               TextWrapping="Wrap"/>
   </StackPanel>
  </ScrollViewer>

  <Grid Grid.Row="6">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>

   <Button x:Name="BackButton"
           Grid.Column="0"
           Content="Zurück"
           Width="105"
           Padding="10,7"
           Style="{StaticResource SecondaryButton}"
           Click="Back_Click"/>

   <Button x:Name="CancelButton"
           Grid.Column="2"
           Content="Abbrechen"
           Width="105"
           Padding="10,7"
           Margin="8,0,0,0"
           Style="{StaticResource SecondaryButton}"
           Click="Cancel_Click"/>

   <Button x:Name="SkipButton"
           Grid.Column="3"
           Content="Weiß ich nicht"
           MinWidth="130"
           Padding="10,7"
           Margin="8,0,0,0"
           Style="{StaticResource SecondaryButton}"
           Click="Skip_Click"/>

   <Button x:Name="ApplyCalculateButton"
           Grid.Column="3"
           Content="Übernehmen &amp; berechnen"
           MinWidth="180"
           Padding="10,7"
           Margin="8,0,0,0"
           Visibility="Collapsed"
           Click="ApplyCalculate_Click"/>

   <Button x:Name="NextButton"
           Grid.Column="4"
           Content="Weiter"
           Width="115"
           Padding="10,7"
           Margin="8,0,0,0"
           Click="Next_Click"/>
  </Grid>
 </Grid>
</Window>
