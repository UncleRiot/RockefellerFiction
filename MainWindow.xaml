<Window x:Class="RockefellerFiction.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RockefellerFiction"
 Icon="Resources/AppIcon.ico"
 PreviewMouseDown="Window_PreviewMouseDown"
 Closing="Window_Closing">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Design.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Margin="{StaticResource PagePadding}" Background="{StaticResource BgBrush}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="RockefellerFiction" Style="{StaticResource HeaderTitle}"/>
    <TextBlock Text="Blaues ? = Erklärung."
               Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
    <TextBlock Text="WARNUNG: Experimentelles Tool. Nicht für reale Finanzplanung oder tatsächliche Finanz-, Anlage-, Steuer-, Rechts- oder Rentenentscheidungen verwenden. Die Ergebnisse sind unverbindliche Modellrechnungen und können unvollständig oder fehlerhaft sein. Keine Finanz-, Anlage-, Steuer-, Rechts- oder Rentenberatung. Vor realen Entscheidungen fachkundige Beratung und amtliche Auskünfte einholen."
               Foreground="{StaticResource DangerBrush}"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               MaxWidth="850"
               Margin="0,8,16,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
    <Button Content="Berechnen" Width="100" Padding="10,6" Margin="0,0,8,0" Click="Calculate_Click"/>
    <Button Content="Speichern" Width="100" Padding="10,6" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="Save_Click"/>
    <Button Content="Export" Width="100" Padding="10,6" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="Export_Click"/>
    <Button Content="Import" Width="100" Padding="10,6" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Click="Import_Click"/>
    <StackPanel>
     <Button Content="About"
             Width="100"
             Padding="10,6"
             Style="{StaticResource SecondaryButton}"
             Click="About_Click"/>
     <Button Width="100"
             Margin="0,8,0,0"
             Padding="6"
             Style="{StaticResource SecondaryButton}"
             Click="Wizard_Click"
             ToolTip="Neu hier? Mit dem Wizard Schritt für Schritt zur ersten sinnvollen Simulation.">
      <StackPanel>
       <Image Source="Resources/Wizard.png"
              Width="52"
              Height="52"
              Stretch="Uniform"/>
       <TextBlock Text="Wizard"
                  HorizontalAlignment="Center"
                  Margin="0,4,0,0"
                  FontWeight="SemiBold"/>
      </StackPanel>
     </Button>
    </StackPanel>
   </StackPanel>
  </Grid>

  <TabControl Grid.Row="2"
              x:Name="MainTabs"
              SelectionChanged="MainTabs_SelectionChanged">
   <TabItem Header="Eingaben">
    <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
     <TabControl x:Name="InputSubTabs">
      <TabControl.ItemsPanel>
       <ItemsPanelTemplate>
        <UniformGrid Rows="2"/>
       </ItemsPanelTemplate>
      </TabControl.ItemsPanel>
      <TabControl.Template>
       <ControlTemplate TargetType="TabControl">
        <Grid KeyboardNavigation.TabNavigation="Local">
         <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
         </Grid.RowDefinitions>
         <ItemsPresenter Grid.Row="0"
                         KeyboardNavigation.TabIndex="1"/>
         <Border Grid.Row="1"
                 Background="{TemplateBinding Background}"
                 BorderBrush="{TemplateBinding BorderBrush}"
                 BorderThickness="1"
                 KeyboardNavigation.TabNavigation="Local"
                 KeyboardNavigation.DirectionalNavigation="Contained"
                 KeyboardNavigation.TabIndex="2">
          <ContentPresenter x:Name="PART_SelectedContentHost"
                            ContentSource="SelectedContent"/>
         </Border>
        </Grid>
       </ControlTemplate>
      </TabControl.Template>
     </TabControl>
    </Border>
   </TabItem>

   <TabItem Header="Berechnungsgrundlagen">
    <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
     <ScrollViewer VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto">
      <TextBlock x:Name="CalculationDocumentationText"
                 TextWrapping="Wrap"
                 FontFamily="Consolas"
                 FontSize="13"
                 Foreground="{StaticResource TextBrush}"/>
     </ScrollViewer>
    </Border>
   </TabItem>

   <TabItem Header="Protokoll">
    <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Button Grid.Row="0"
              Content="Protokoll kopieren"
              HorizontalAlignment="Right"
              Margin="0,0,0,8"
              Click="CopyCalculationLog_Click"/>

      <TextBox Grid.Row="1"
               x:Name="CalculationLogText"
               Width="Auto"
               Height="Auto"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               VerticalContentAlignment="Top"
               IsReadOnly="True"
               AcceptsReturn="True"
               AcceptsTab="True"
               TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               FontFamily="Consolas"
               FontSize="13"
               Foreground="{StaticResource TextBrush}"/>
     </Grid>
    </Border>
   </TabItem>
  </TabControl>

  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Text="Bereit." Style="{StaticResource MutedText}"/>
   <Button Grid.Column="1" Content="Ergebnisse öffnen" Width="{StaticResource ResultsButtonWidth}"
           IsEnabled="False" x:Name="ResultsButton" Click="Results_Click"/>
  </Grid>
 </Grid>
</Window>
