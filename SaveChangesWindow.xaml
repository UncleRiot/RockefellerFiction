<Window x:Class="RockefellerFiction.SaveChangesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RockefellerFiction - Ungespeicherte Änderungen"
 Icon="Resources/AppIcon.ico"
 Width="560"
 Height="220"
 ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Design.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>

 <Grid Margin="{StaticResource PagePadding}" Background="{StaticResource BgBrush}">
  <Grid.RowDefinitions>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel>
   <TextBlock Text="Ungespeicherte Änderungen"
              Style="{StaticResource SubHeader}"
              Margin="0,0,0,12"/>
   <TextBlock Text="Die Eingaben wurden seit dem letzten Speichern geändert. Sollen die Änderungen vor dem Beenden in settings.json gespeichert werden?"
              TextWrapping="Wrap"
              Foreground="{StaticResource TextBrush}"/>
  </StackPanel>

  <StackPanel Grid.Row="1"
              Orientation="Horizontal"
              HorizontalAlignment="Right"
              Margin="0,20,0,0">
   <Button Content="Speichern"
           Width="{StaticResource HeaderButtonWidth}"
           Margin="0,0,8,0"
           Click="Save_Click"/>
   <Button Content="Nicht speichern"
           Width="{StaticResource HeaderButtonWidth}"
           Margin="0,0,8,0"
           Style="{StaticResource SecondaryButton}"
           Click="Discard_Click"/>
   <Button Content="Abbrechen"
           Width="{StaticResource HeaderButtonWidth}"
           Style="{StaticResource SecondaryButton}"
           Click="Cancel_Click"/>
  </StackPanel>
 </Grid>
</Window>
