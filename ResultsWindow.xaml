<Window x:Class="RockefellerFiction.ResultsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RockefellerFiction - Ergebnisse">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Design.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>

 <ScrollViewer HorizontalScrollBarVisibility="Auto"
               VerticalScrollBarVisibility="Auto"
               CanContentScroll="False">
  <Grid Margin="{StaticResource PagePadding}" Background="{StaticResource BgBrush}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="220"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <TextBlock Text="Ergebnisse" Style="{StaticResource HeaderTitle}"/>
   <TextBlock Grid.Column="1"
              x:Name="StrategyText"
              Foreground="{StaticResource MutedTextBrush}"
              VerticalAlignment="Bottom"/>
  </Grid>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="12"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

   <Border Style="{StaticResource CardBorder}">
    <StackPanel>
     <TextBlock Text="Basisszenario" Style="{StaticResource SubHeader}"/>
     <TextBlock x:Name="BaseStatus" Style="{StaticResource ResultStatus}"/>
     <TextBlock x:Name="BaseText" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>

   <Border Grid.Column="2" Style="{StaticResource CardBorder}">
    <StackPanel>
     <TextBlock Text="Stressszenario" Style="{StaticResource SubHeader}"/>
     <TextBlock x:Name="StressStatus" Style="{StaticResource ResultStatus}"/>
     <TextBlock x:Name="StressText" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </Grid>

  <Border Grid.Row="4" Style="{StaticResource CardBorder}">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <TextBlock Text="Vermögensentwicklung" Style="{StaticResource SubHeader}"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <TextBlock Text="● Basis" Foreground="#4AA3FF" Margin="0,0,16,0"/>
      <TextBlock Text="● Stress" Foreground="#F3B33D"/>
     </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,10,0,0">
     <Canvas x:Name="CapitalChart" Background="#171717" ClipToBounds="True"/>
     <TextBlock x:Name="ChartEmptyText"
                Text="Keine Daten"
                Foreground="{StaticResource MutedTextBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed"/>
    </Grid>
   </Grid>
  </Border>

  <Border Grid.Row="6" Style="{StaticResource CardBorder}">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="2*"/>
     <ColumnDefinition Width="16"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <StackPanel>
     <TextBlock Text="Handlungsempfehlung" Style="{StaticResource SubHeader}"/>
     <TextBlock x:Name="RecommendationText" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>

    <StackPanel Grid.Column="2">
     <TextBlock Text="Ausgaben ±10 %" Style="{StaticResource SubHeader}"/>
     <TextBlock x:Name="SensitivityText" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>
  </Border>

  <TabControl Grid.Row="8">
   <TabItem Header="Basis: Jahresübersicht">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>

     <Border Grid.Row="0"
             Background="#202020"
             BorderBrush="#3A3A3A"
             BorderThickness="0,0,0,1"
             Padding="10,7">
      <StackPanel>
       <TextBlock Text="Gesamtbedarf p.a. = Lebenshaltung p.a. + GKV/Pflege gesamt p.a."
                  FontWeight="SemiBold"/>
       <TextBlock Text="GKV/Pflege gesamt p.a. = (GKV/Pflege P1 mtl. + GKV/Pflege P2 mtl.) × 12"
                  Foreground="{StaticResource MutedTextBrush}"
                  Margin="0,3,0,0"/>
      </StackPanel>
     </Border>

     <Grid Grid.Row="1">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="#171717">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="185"/>
        <ColumnDefinition Width="805"/>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="310"/>
        <ColumnDefinition Width="125"/>
        <ColumnDefinition Width="115"/>
        <ColumnDefinition Width="70"/>
       </Grid.ColumnDefinitions>

       <Border Grid.Column="0" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Planungsjahr &amp; Alter" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border x:Name="BaseExpenseGroupBorder" Grid.Column="1" Background="#3A1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Ausgaben &amp; Vorsorge" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border x:Name="BasePensionGroupBorder" Grid.Column="2" Background="#17351F" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Gesetzliche Rente" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border Grid.Column="3" Background="#17351F" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Einnahmen &amp; Mittelzufluss" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border Grid.Column="4" Background="#3A1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Steuern" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border x:Name="BaseWealthGroupBorder" Grid.Column="5" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Vermögen" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border Grid.Column="6" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="6,5">
        <TextBlock Text="Planstatus" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
      </Grid>

      <DataGrid Grid.Row="1"
                x:Name="YearGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Jahr" Binding="{Binding Year}" Width="65"/>
        <DataGridTextColumn Header="Alter 1" Binding="{Binding Age1}" Width="60"/>
        <DataGridTextColumn Header="Alter 2" Binding="{Binding Age2}" Width="60"/>
        <DataGridTextColumn Header="Gesamtbedarf p.a." Binding="{Binding TotalAnnualNeed, StringFormat={}{0:N0} €}" Width="120"/>
        <DataGridTextColumn Header="davon Lebenshaltung p.a." Binding="{Binding LivingCosts, StringFormat={}{0:N0} €}" Width="145"/>
        <DataGridTextColumn Header="Inflationsanstieg p.a." Binding="{Binding LivingCostIncrease, StringFormat={}{0:N0} €}" Width="135"/>
        <DataGridTextColumn Header="davon GKV/Pflege gesamt p.a." Binding="{Binding HealthCareCosts, StringFormat={}{0:N0} €}" Width="165"/>
        <DataGridTextColumn Header="GKV/Pflege P1 mtl." Binding="{Binding HealthCareCostsPerson1Monthly, StringFormat={}{0:N0} €}" Width="120"/>
        <DataGridTextColumn Header="GKV/Pflege P2 mtl." Binding="{Binding HealthCareCostsPerson2Monthly, StringFormat={}{0:N0} €}" Width="120"/>
        <DataGridTextColumn Header="Rente brutto p.a." Binding="{Binding PensionGross, StringFormat={}{0:N0} €}" Width="120"/>
        <DataGridTextColumn Header="Rente netto p.a." Binding="{Binding PensionNet, StringFormat={}{0:N0} €}" Width="120"/>
        <DataGridTextColumn Header="Dividenden brutto p.a." Binding="{Binding DividendsGross, StringFormat={}{0:N0} €}" Width="110"/>
        <DataGridTextColumn Header="Zinsen brutto p.a." Binding="{Binding InterestGross, StringFormat={}{0:N0} €}" Width="95"/>
        <DataGridTextColumn Header="Entnahme p.a." Binding="{Binding WithdrawnFromCapital, StringFormat={}{0:N0} €}" Width="105"/>
        <DataGridTextColumn Header="Steuern Kapital p.a." Binding="{Binding TaxesOnCapital, StringFormat={}{0:N0} €}" Width="125"/>
        <DataGridTextColumn Header="Vermögen Ende" Binding="{Binding TotalPortfolioEnd, StringFormat={}{0:N0} €}" Width="115"/>
        <DataGridTextColumn Header="Status" Binding="{Binding YearStatus}" Width="70"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Grid>
   </TabItem>

   <TabItem Header="Stress: Jahresübersicht">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>

     <Border Grid.Row="0"
             Background="#202020"
             BorderBrush="#3A3A3A"
             BorderThickness="0,0,0,1"
             Padding="10,7">
      <StackPanel>
       <TextBlock Text="Gesamtbedarf p.a. = Lebenshaltung p.a. + GKV/Pflege gesamt p.a."
                  FontWeight="SemiBold"/>
       <TextBlock Text="GKV/Pflege gesamt p.a. = (GKV/Pflege P1 mtl. + GKV/Pflege P2 mtl.) × 12"
                  Foreground="{StaticResource MutedTextBrush}"
                  Margin="0,3,0,0"/>
      </StackPanel>
     </Border>

     <Grid Grid.Row="1">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="#171717">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="185"/>
        <ColumnDefinition Width="670"/>
        <ColumnDefinition Width="105"/>
        <ColumnDefinition Width="195"/>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="70"/>
       </Grid.ColumnDefinitions>

       <Border Grid.Column="0" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Planungsjahr &amp; Alter" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border x:Name="StressExpenseGroupBorder" Grid.Column="1" Background="#3A1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Ausgaben &amp; Vorsorge" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border x:Name="StressPensionGroupBorder" Grid.Column="2" Background="#17351F" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Gesetzliche Rente" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border Grid.Column="3" Background="#17351F" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Einnahmen &amp; Mittelzufluss" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border Grid.Column="4" Background="#3A1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Steuern" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border x:Name="StressWealthGroupBorder" Grid.Column="5" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Vermögen &amp; Reserve" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border Grid.Column="6" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="6,5">
        <TextBlock Text="Planstatus" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
      </Grid>

      <DataGrid Grid.Row="1"
                x:Name="StressYearGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Jahr" Binding="{Binding Year}" Width="65"/>
        <DataGridTextColumn Header="Alter 1" Binding="{Binding Age1}" Width="60"/>
        <DataGridTextColumn Header="Alter 2" Binding="{Binding Age2}" Width="60"/>
        <DataGridTextColumn Header="Gesamtbedarf p.a." Binding="{Binding TotalAnnualNeed, StringFormat={}{0:N0} €}" Width="120"/>
        <DataGridTextColumn Header="davon Lebenshaltung p.a." Binding="{Binding LivingCosts, StringFormat={}{0:N0} €}" Width="145"/>
        <DataGridTextColumn Header="davon GKV/Pflege gesamt p.a." Binding="{Binding HealthCareCosts, StringFormat={}{0:N0} €}" Width="165"/>
        <DataGridTextColumn Header="GKV/Pflege P1 mtl." Binding="{Binding HealthCareCostsPerson1Monthly, StringFormat={}{0:N0} €}" Width="120"/>
        <DataGridTextColumn Header="GKV/Pflege P2 mtl." Binding="{Binding HealthCareCostsPerson2Monthly, StringFormat={}{0:N0} €}" Width="120"/>
        <DataGridTextColumn Header="Rente netto p.a." Binding="{Binding PensionNet, StringFormat={}{0:N0} €}" Width="105"/>
        <DataGridTextColumn Header="Dividenden brutto p.a." Binding="{Binding DividendsGross, StringFormat={}{0:N0} €}" Width="100"/>
        <DataGridTextColumn Header="Entnahme p.a." Binding="{Binding WithdrawnFromCapital, StringFormat={}{0:N0} €}" Width="95"/>
        <DataGridTextColumn Header="Steuern Kapital p.a." Binding="{Binding TaxesOnCapital, StringFormat={}{0:N0} €}" Width="110"/>
        <DataGridTextColumn Header="Reserve Ist" Binding="{Binding ReserveActual, StringFormat={}{0:N0} €}" Width="105"/>
        <DataGridTextColumn Header="Vermögen Ende" Binding="{Binding TotalPortfolioEnd, StringFormat={}{0:N0} €}" Width="115"/>
        <DataGridTextColumn Header="Status" Binding="{Binding YearStatus}" Width="70"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Grid>
   </TabItem>

   <TabItem Header="Finanzierung der Ausgaben">
    <DataGrid x:Name="FundingGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Jahr" Binding="{Binding Year}" Width="70"/>
      <DataGridTextColumn Header="Gesamtbedarf p.a." Binding="{Binding TotalAnnualNeed, StringFormat={}{0:N0} €}" Width="120"/>
      <DataGridTextColumn Header="aus Rente" Binding="{Binding FundingFromPension, StringFormat={}{0:N0} €}" Width="110"/>
      <DataGridTextColumn Header="aus Dividenden" Binding="{Binding FundingFromDividends, StringFormat={}{0:N0} €}" Width="125"/>
      <DataGridTextColumn Header="sonstige Einnahmen" Binding="{Binding FundingFromOtherIncome, StringFormat={}{0:N0} €}" Width="135"/>
      <DataGridTextColumn Header="aus Vermögen" Binding="{Binding FundingFromCapital, StringFormat={}{0:N0} €}" Width="120"/>
      <DataGridTextColumn Header="Finanzierungslücke" Binding="{Binding FundingGap, StringFormat={}{0:N0} €}" Width="130"/>
      <DataGridTextColumn Header="Kapitalsteuer" Binding="{Binding TaxesOnCapital, StringFormat={}{0:N0} €}" Width="110"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>

   <TabItem Header="Anlageklassen">
    <DataGrid x:Name="AssetGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Jahr" Binding="{Binding Year}" Width="70"/>
      <DataGridTextColumn Header="Tages/Festgeld" Binding="{Binding CashEnd, StringFormat={}{0:N0} €}" Width="120"/>
      <DataGridTextColumn Header="Welt-ETF" Binding="{Binding WorldEtfEnd, StringFormat={}{0:N0} €}" Width="120"/>
      <DataGridTextColumn Header="Dividenden-ETF" Binding="{Binding DividendEtfEnd, StringFormat={}{0:N0} €}" Width="120"/>
      <DataGridTextColumn Header="Dividenden-Aktien" Binding="{Binding DividendStocksEnd, StringFormat={}{0:N0} €}" Width="130"/>
      <DataGridTextColumn Header="Zins Tages/Festgeld" Binding="{Binding CashReturnContribution, StringFormat={}{0:N0} €}" Width="135"/>
      <DataGridTextColumn Header="Zins netto" Binding="{Binding CashNetIncome, StringFormat={}{0:N0} €}" Width="105"/>
      <DataGridTextColumn Header="Welt-ETF Kurs" Binding="{Binding WorldPriceReturnContribution, StringFormat={}{0:N0} €}" Width="115"/>
      <DataGridTextColumn Header="Welt-ETF Ausschüttung" Binding="{Binding WorldDistributionContribution, StringFormat={}{0:N0} €}" Width="145"/>
      <DataGridTextColumn Header="Welt-ETF Ausschüttung netto" Binding="{Binding WorldNetIncome, StringFormat={}{0:N0} €}" Width="170"/>
      <DataGridTextColumn Header="Div.-ETF Kurs" Binding="{Binding DividendEtfPriceReturnContribution, StringFormat={}{0:N0} €}" Width="110"/>
      <DataGridTextColumn Header="Div.-ETF Ausschüttung" Binding="{Binding DividendEtfDistributionContribution, StringFormat={}{0:N0} €}" Width="140"/>
      <DataGridTextColumn Header="Div.-ETF Ausschüttung netto" Binding="{Binding DividendEtfNetIncome, StringFormat={}{0:N0} €}" Width="165"/>
      <DataGridTextColumn Header="Div.-Aktien Kurs" Binding="{Binding DividendStocksPriceReturnContribution, StringFormat={}{0:N0} €}" Width="120"/>
      <DataGridTextColumn Header="Div.-Aktien Dividende" Binding="{Binding DividendStocksDistributionContribution, StringFormat={}{0:N0} €}" Width="140"/>
      <DataGridTextColumn Header="Div.-Aktien Dividende netto" Binding="{Binding DividendStocksNetIncome, StringFormat={}{0:N0} €}" Width="165"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>

   <TabItem Header="Reserve &amp; Rücklagen">
    <DataGrid x:Name="ReserveGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Jahr" Binding="{Binding Year}" Width="70"/>
      <DataGridTextColumn Header="Haus" Binding="{Binding HouseReserveTarget, StringFormat={}{0:N0} €}" Width="105"/>
      <DataGridTextColumn Header="Auto" Binding="{Binding CarReserveTarget, StringFormat={}{0:N0} €}" Width="105"/>
      <DataGridTextColumn Header="Gesundheit" Binding="{Binding HealthReserveTarget, StringFormat={}{0:N0} €}" Width="105"/>
      <DataGridTextColumn Header="Reisen" Binding="{Binding TravelReserveTarget, StringFormat={}{0:N0} €}" Width="105"/>
      <DataGridTextColumn Header="Sonstiges" Binding="{Binding OtherReserveTarget, StringFormat={}{0:N0} €}" Width="105"/>
      <DataGridTextColumn Header="Reserve Soll gesamt" Binding="{Binding ReserveTarget, StringFormat={}{0:N0} €}" Width="135"/>
      <DataGridTextColumn Header="Reserve Ist" Binding="{Binding ReserveActual, StringFormat={}{0:N0} €}" Width="110"/>
      <DataGridTextColumn Header="Status" Binding="{Binding YearStatus}" Width="80"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
  </TabControl>
  </Grid>
 </ScrollViewer>
</Window>
