<Window x:Class="RockefellerFiction.ResultsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RockefellerFiction - Ergebnisse"
 PreviewMouseWheel="Window_PreviewMouseWheel">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Design.xaml"/>
   </ResourceDictionary.MergedDictionaries>

   <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                    Color="#2363EB"/>
   <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                    Color="#F2F2F2"/>

   <Style x:Key="CompactYearGridCell"
          TargetType="DataGridCell"
          BasedOn="{StaticResource {x:Type DataGridCell}}">
    <Setter Property="Padding" Value="4,3"/>
   </Style>

   <Style x:Key="ResultColumnHeader"
          TargetType="DataGridColumnHeader"
          BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
    <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
    <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
    <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
    <EventSetter Event="MouseEnter"
                 Handler="ResultColumnHeader_MouseEnter"/>
   </Style>

   <Style x:Key="WrappedYearColumnHeader"
          TargetType="DataGridColumnHeader"
          BasedOn="{StaticResource ResultColumnHeader}">
    <Setter Property="Padding" Value="4,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="ContentTemplate">
     <Setter.Value>
      <DataTemplate>
       <TextBlock Text="{Binding}"
                  TextWrapping="Wrap"
                  TextAlignment="Center"/>
      </DataTemplate>
     </Setter.Value>
    </Setter>
   </Style>

   <Style x:Key="OptionalDetailColumnHeader"
          TargetType="DataGridColumnHeader"
          BasedOn="{StaticResource WrappedYearColumnHeader}">
    <Setter Property="Background" Value="#2B3540"/>
   </Style>

   <Style x:Key="OptionalDetailColumnCell"
          TargetType="DataGridCell"
          BasedOn="{StaticResource CompactYearGridCell}">
    <Setter Property="Background" Value="#202A33"/>
   </Style>
  </ResourceDictionary>
 </Window.Resources>

 <ScrollViewer x:Name="ResultsScrollViewer"
               HorizontalScrollBarVisibility="Auto"
               VerticalScrollBarVisibility="Auto"
               CanContentScroll="False">
  <Grid Margin="{StaticResource PagePadding}" Background="{StaticResource BgBrush}">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="12"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="Ergebnisse"
               Style="{StaticResource HeaderTitle}"
               VerticalAlignment="Center"/>
    <Button x:Name="ExcelExportButton"
            Content="Export (Excel)"
            Margin="16,0,0,0"
            Padding="12,6"
            VerticalAlignment="Center"
            Click="ExcelExportButton_Click"/>
   </StackPanel>
   <TextBlock Grid.Column="1"
              x:Name="StrategyText"
              Foreground="{StaticResource MutedTextBrush}"
              VerticalAlignment="Bottom"/>
  </Grid>

  <Expander Grid.Row="2"
            x:Name="OverviewPaneExpander"
            IsExpanded="True"
            Expanded="PaneExpansion_Changed"
            Collapsed="PaneExpansion_Changed">
   <Expander.Header>
    <TextBlock Text="Übersicht"
               Style="{StaticResource SubHeader}"
               Foreground="{StaticResource TextBrush}"/>
   </Expander.Header>
   <StackPanel>
    <Border Margin="0,8,0,0"
            Style="{StaticResource CardBorder}"
            VerticalAlignment="Top">
     <Expander x:Name="CapitalPaneExpander"
               IsExpanded="True"
               Expanded="PaneExpansion_Changed"
               Collapsed="PaneExpansion_Changed">
      <Expander.Header>
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Vermögensentwicklung"
                   Style="{StaticResource SubHeader}"
                   Foreground="{StaticResource TextBrush}"/>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="18,0,0,0">
         <TextBlock Text="● Basis"
                    Foreground="#4AA3FF"
                    Margin="0,0,16,0"/>
         <TextBlock Text="● Stress"
                    Foreground="#F3B33D"/>
        </StackPanel>
       </Grid>
      </Expander.Header>

      <Grid Margin="0,10,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="1"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="1"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>

       <Border Grid.Column="1"
               Background="{StaticResource BorderBrush}"
               Margin="12,0"/>

       <Border Grid.Column="3"
               Background="{StaticResource BorderBrush}"
               Margin="12,0"/>

       <Grid Grid.Column="0"
             Height="150">
        <Canvas x:Name="CapitalChart"
                Background="#171717"
                ClipToBounds="True"/>
        <TextBlock x:Name="ChartEmptyText"
                   Text="Keine Daten"
                   Foreground="{StaticResource MutedTextBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
       </Grid>

       <Expander Grid.Column="2"
                 x:Name="BasePaneExpander"
                 IsExpanded="True"
                 MaxWidth="380"
                 VerticalAlignment="Top"
                 Expanded="PaneExpansion_Changed"
                 Collapsed="PaneExpansion_Changed">
        <Expander.Header>
         <TextBlock Text="Basisszenario"
                    Style="{StaticResource SubHeader}"
                    Foreground="{StaticResource TextBrush}"/>
        </Expander.Header>
        <StackPanel Margin="0,6,0,0">
         <TextBlock x:Name="BaseStatus"
                    Style="{StaticResource ResultStatus}"/>
         <TextBlock x:Name="BaseText"
                    TextWrapping="Wrap"/>
        </StackPanel>
       </Expander>

       <Expander Grid.Column="4"
                 x:Name="StressPaneExpander"
                 IsExpanded="True"
                 MaxWidth="380"
                 VerticalAlignment="Top"
                 Expanded="PaneExpansion_Changed"
                 Collapsed="PaneExpansion_Changed">
        <Expander.Header>
         <TextBlock Text="Stressszenario"
                    Style="{StaticResource SubHeader}"
                    Foreground="{StaticResource TextBrush}"/>
        </Expander.Header>
        <StackPanel Margin="0,6,0,0">
         <TextBlock x:Name="StressStatus"
                    Style="{StaticResource ResultStatus}"/>
         <TextBlock x:Name="StressText"
                    TextWrapping="Wrap"/>
        </StackPanel>
       </Expander>
      </Grid>
     </Expander>
    </Border>

    <Border Height="12"
            Background="Transparent"/>

    <Border Style="{StaticResource CardBorder}"
            VerticalAlignment="Top">
     <Expander x:Name="RecommendationPaneExpander"
               IsExpanded="True"
               Expanded="PaneExpansion_Changed"
               Collapsed="PaneExpansion_Changed">
      <Expander.Header>
       <TextBlock Text="Handlungsempfehlung"
                  Style="{StaticResource SubHeader}"
                  Foreground="{StaticResource TextBrush}"/>
      </Expander.Header>
      <StackPanel Margin="0,8,0,0">
       <TextBlock x:Name="RecommendationText"
                  TextWrapping="Wrap"/>
       <TextBlock Text="Ausgaben-Check (±10 % Lebenshaltungskosten)"
                  FontWeight="SemiBold"
                  Foreground="{StaticResource TextBrush}"
                  Margin="0,10,0,3"/>
       <TextBlock x:Name="SensitivityText"
                  TextWrapping="Wrap"/>
      </StackPanel>
     </Expander>
    </Border>
   </StackPanel>
  </Expander>

  <TabControl Grid.Row="4">
   <TabItem Header="Basis: Jahresübersicht">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>

     <Border Grid.Row="0"
             Background="#202020"
             BorderBrush="#3A3A3A"
             BorderThickness="0,0,0,1"
             Padding="10,7">
      <StackPanel>
       <TextBlock Text="Gesamtbedarf p.a. = Lebenshaltung p.a. + Rücklagen / Sonderausgaben p.a. + freiwillige GKV/Pflege gesamt p.a."
                  FontWeight="SemiBold"/>
       <TextBlock Text="Freiwillige GKV/Pflege gesamt p.a. = (P1 mtl. + P2 mtl.) × 12. GKV/Pflege-Abzüge auf Renten stehen separat unter Gesetzliche Rente."
                  Foreground="{StaticResource MutedTextBrush}"
                  Margin="0,3,0,0"/>
       <CheckBox x:Name="BaseHealthDetailsToggle"
                 Content="Details P1/P2 anzeigen"
                 IsChecked="False"
                 Margin="0,6,0,0"
                 Checked="HealthDetailsToggle_Changed"
                 Unchecked="HealthDetailsToggle_Changed"/>
      </StackPanel>
     </Border>

     <Grid Grid.Row="1">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0"
            x:Name="BaseGroupHeaderGrid"
            Background="#171717"
            HorizontalAlignment="Left">
       <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="BasePlanGroupColumn"/>
        <ColumnDefinition x:Name="BaseExpenseGroupColumn"/>
        <ColumnDefinition x:Name="BasePensionGroupColumn"/>
        <ColumnDefinition x:Name="BaseIncomeGroupColumn"/>
        <ColumnDefinition x:Name="BaseTaxGroupColumn"/>
        <ColumnDefinition x:Name="BaseWealthGroupColumn"/>
        <ColumnDefinition x:Name="BaseStatusGroupColumn"/>
       </Grid.ColumnDefinitions>

       <Border Grid.Column="0" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Planungsjahr &amp; Alter" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border x:Name="BaseExpenseGroupBorder" Grid.Column="1" Background="#3A1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Ausgaben &amp; Vorsorge" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border x:Name="BasePensionGroupBorder" Grid.Column="2" Background="#17351F" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Rente" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border Grid.Column="3" Background="#17351F" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Einnahmen &amp; Mittelzufluss" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border Grid.Column="4" Background="#3A1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Steuern" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border x:Name="BaseWealthGroupBorder" Grid.Column="5" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Vermögen" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border Grid.Column="6" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="6,5">
        <TextBlock Text="Planstatus" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
      </Grid>

      <DataGrid Grid.Row="1"
                x:Name="YearGrid"
                AutoGenerateColumns="False"
                CellStyle="{StaticResource CompactYearGridCell}"
                IsReadOnly="True"
                CanUserAddRows="False"
                HorizontalAlignment="Left"
                ColumnHeaderStyle="{StaticResource WrappedYearColumnHeader}">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Jahr" Binding="{Binding Year}" Width="50"/>
        <DataGridTextColumn Header="P1 Alter" Binding="{Binding Age1}" Width="48"/>
        <DataGridTextColumn Header="P2 Alter" Binding="{Binding Age2}" Width="48"/>
        <DataGridTextColumn Header="Gesamtbedarf p.a." Binding="{Binding TotalAnnualNeed, StringFormat={}{0:N0} €}" Width="90"/>
        <DataGridTextColumn Header="davon Lebenshaltung p.a." Binding="{Binding LivingCosts, StringFormat={}{0:N0} €}" Width="100"/>
        <DataGridTextColumn Header="Rücklagen / Sonderausgaben p.a." Binding="{Binding ReserveAndSpecialExpenses, StringFormat={}{0:N0} €}" Width="120"/>
        <DataGridTextColumn Header="Inflationsanstieg p.a." Binding="{Binding LivingCostIncrease, StringFormat={}{0:N0} €}" Width="90"/>
        <DataGridTextColumn Header="davon freiwillige GKV/Pflege gesamt p.a." Binding="{Binding HealthCareCosts, StringFormat={}{0:N0} €}" Width="100"/>
        <DataGridTextColumn Header="freiw. GKV/Pflege P1 mtl." Visibility="Collapsed" Binding="{Binding HealthCareCostsPerson1Monthly, StringFormat={}{0:N0} €}" Width="80" HeaderStyle="{StaticResource OptionalDetailColumnHeader}" CellStyle="{StaticResource OptionalDetailColumnCell}"/>
        <DataGridTextColumn Header="freiw. GKV/Pflege P2 mtl." Visibility="Collapsed" Binding="{Binding HealthCareCostsPerson2Monthly, StringFormat={}{0:N0} €}" Width="80" HeaderStyle="{StaticResource OptionalDetailColumnHeader}" CellStyle="{StaticResource OptionalDetailColumnCell}"/>
        <DataGridTextColumn Header="Rente netto p.a." Binding="{Binding PensionNet, StringFormat={}{0:N0} €}" Width="90"/>
        <DataGridTextColumn Header="Rente brutto p.a." Visibility="Collapsed" Binding="{Binding PensionGross, StringFormat={}{0:N0} €}" Width="90" HeaderStyle="{StaticResource OptionalDetailColumnHeader}" CellStyle="{StaticResource OptionalDetailColumnCell}"/>
        <DataGridTextColumn Header="Rente P1 brutto p.a." Visibility="Collapsed" Binding="{Binding PensionPerson1Gross, StringFormat={}{0:N0} €}" Width="90" HeaderStyle="{StaticResource OptionalDetailColumnHeader}" CellStyle="{StaticResource OptionalDetailColumnCell}"/>
        <DataGridTextColumn Header="Rente P2 brutto p.a." Visibility="Collapsed" Binding="{Binding PensionPerson2Gross, StringFormat={}{0:N0} €}" Width="90" HeaderStyle="{StaticResource OptionalDetailColumnHeader}" CellStyle="{StaticResource OptionalDetailColumnCell}"/>
        <DataGridTextColumn Header="GKV/Pflege aus Rente p.a." Visibility="Collapsed" Binding="{Binding PensionHealthAndCareDeductions, StringFormat={}{0:N0} €}" Width="100" HeaderStyle="{StaticResource OptionalDetailColumnHeader}" CellStyle="{StaticResource OptionalDetailColumnCell}"/>
        <DataGridTextColumn Header="Nettoeinkommen P2 verwendet p.a." Binding="{Binding FundingFromPerson2Income, StringFormat={}{0:N0} €}" Width="115"/>
        <DataGridTextColumn Header="Ausschüttungen erhalten p.a." Binding="{Binding DividendsGross, StringFormat={}{0:N0} €}" Width="110"/>
        <DataGridTextColumn Header="Zinsen erhalten p.a." Binding="{Binding InterestGross, StringFormat={}{0:N0} €}" Width="90"/>
        <DataGridTextColumn Header="Aus Vermögen entnommen p.a." Binding="{Binding WithdrawnFromCapital, StringFormat={}{0:N0} €}" Width="115"/>
        <DataGridTextColumn Header="Steuern auf Kapitalerträge p.a." Binding="{Binding TaxesOnCapital, StringFormat={}{0:N0} €}" Width="115"/>
        <DataGridTextColumn Header="Vermögen Ende" Binding="{Binding TotalPortfolioEnd, StringFormat={}{0:N0} €}" Width="100"/>
        <DataGridTextColumn Header="Status" Binding="{Binding YearStatus}" Width="60"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Grid>
   </TabItem>

   <TabItem Header="Stress: Jahresübersicht">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>

     <Border Grid.Row="0"
             Background="#202020"
             BorderBrush="#3A3A3A"
             BorderThickness="0,0,0,1"
             Padding="10,7">
      <StackPanel>
       <TextBlock Text="Gesamtbedarf p.a. = Lebenshaltung p.a. + Rücklagen / Sonderausgaben p.a. + freiwillige GKV/Pflege gesamt p.a."
                  FontWeight="SemiBold"/>
       <TextBlock Text="Freiwillige GKV/Pflege gesamt p.a. = (P1 mtl. + P2 mtl.) × 12. GKV/Pflege-Abzüge auf Renten stehen separat unter Gesetzliche Rente."
                  Foreground="{StaticResource MutedTextBrush}"
                  Margin="0,3,0,0"/>
       <CheckBox x:Name="StressHealthDetailsToggle"
                 Content="Details P1/P2 anzeigen"
                 IsChecked="False"
                 Margin="0,6,0,0"
                 Checked="HealthDetailsToggle_Changed"
                 Unchecked="HealthDetailsToggle_Changed"/>
      </StackPanel>
     </Border>

     <Grid Grid.Row="1">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0"
            x:Name="StressGroupHeaderGrid"
            Background="#171717"
            HorizontalAlignment="Left">
       <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="StressPlanGroupColumn"/>
        <ColumnDefinition x:Name="StressExpenseGroupColumn"/>
        <ColumnDefinition x:Name="StressPensionGroupColumn"/>
        <ColumnDefinition x:Name="StressIncomeGroupColumn"/>
        <ColumnDefinition x:Name="StressTaxGroupColumn"/>
        <ColumnDefinition x:Name="StressWealthGroupColumn"/>
        <ColumnDefinition x:Name="StressStatusGroupColumn"/>
       </Grid.ColumnDefinitions>

       <Border Grid.Column="0" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Planungsjahr &amp; Alter" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border x:Name="StressExpenseGroupBorder" Grid.Column="1" Background="#3A1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Ausgaben &amp; Vorsorge" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border x:Name="StressPensionGroupBorder" Grid.Column="2" Background="#17351F" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Rente" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border Grid.Column="3" Background="#17351F" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Einnahmen &amp; Mittelzufluss" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border Grid.Column="4" Background="#3A1B1B" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Steuern" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border x:Name="StressWealthGroupBorder" Grid.Column="5" BorderBrush="#3A3A3A" BorderThickness="0,0,1,1" Padding="6,5">
        <TextBlock Text="Vermögen &amp; Reserve" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <Border Grid.Column="6" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="6,5">
        <TextBlock Text="Planstatus" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
      </Grid>

      <DataGrid Grid.Row="1"
                x:Name="StressYearGrid"
                AutoGenerateColumns="False"
                CellStyle="{StaticResource CompactYearGridCell}"
                IsReadOnly="True"
                CanUserAddRows="False"
                HorizontalAlignment="Left"
                ColumnHeaderStyle="{StaticResource WrappedYearColumnHeader}">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Jahr" Binding="{Binding Year}" Width="50"/>
        <DataGridTextColumn Header="P1 Alter" Binding="{Binding Age1}" Width="48"/>
        <DataGridTextColumn Header="P2 Alter" Binding="{Binding Age2}" Width="48"/>
        <DataGridTextColumn Header="Gesamtbedarf p.a." Binding="{Binding TotalAnnualNeed, StringFormat={}{0:N0} €}" Width="90"/>
        <DataGridTextColumn Header="davon Lebenshaltung p.a." Binding="{Binding LivingCosts, StringFormat={}{0:N0} €}" Width="100"/>
        <DataGridTextColumn Header="Rücklagen / Sonderausgaben p.a." Binding="{Binding ReserveAndSpecialExpenses, StringFormat={}{0:N0} €}" Width="120"/>
        <DataGridTextColumn Header="davon freiwillige GKV/Pflege gesamt p.a." Binding="{Binding HealthCareCosts, StringFormat={}{0:N0} €}" Width="100"/>
        <DataGridTextColumn Header="freiw. GKV/Pflege P1 mtl." Visibility="Collapsed" Binding="{Binding HealthCareCostsPerson1Monthly, StringFormat={}{0:N0} €}" Width="80" HeaderStyle="{StaticResource OptionalDetailColumnHeader}" CellStyle="{StaticResource OptionalDetailColumnCell}"/>
        <DataGridTextColumn Header="freiw. GKV/Pflege P2 mtl." Visibility="Collapsed" Binding="{Binding HealthCareCostsPerson2Monthly, StringFormat={}{0:N0} €}" Width="80" HeaderStyle="{StaticResource OptionalDetailColumnHeader}" CellStyle="{StaticResource OptionalDetailColumnCell}"/>
        <DataGridTextColumn Header="Rente netto p.a." Binding="{Binding PensionNet, StringFormat={}{0:N0} €}" Width="90"/>
        <DataGridTextColumn Header="GKV/Pflege aus Rente p.a." Visibility="Collapsed" Binding="{Binding PensionHealthAndCareDeductions, StringFormat={}{0:N0} €}" Width="100" HeaderStyle="{StaticResource OptionalDetailColumnHeader}" CellStyle="{StaticResource OptionalDetailColumnCell}"/>
        <DataGridTextColumn Header="Nettoeinkommen P2 verwendet p.a." Binding="{Binding FundingFromPerson2Income, StringFormat={}{0:N0} €}" Width="115"/>
        <DataGridTextColumn Header="Ausschüttungen erhalten p.a." Binding="{Binding DividendsGross, StringFormat={}{0:N0} €}" Width="110"/>
        <DataGridTextColumn Header="Aus Vermögen entnommen p.a." Binding="{Binding WithdrawnFromCapital, StringFormat={}{0:N0} €}" Width="115"/>
        <DataGridTextColumn Header="Steuern auf Kapitalerträge p.a." Binding="{Binding TaxesOnCapital, StringFormat={}{0:N0} €}" Width="115"/>
        <DataGridTextColumn Header="Reserve Ist" Binding="{Binding ReserveActual, StringFormat={}{0:N0} €}" Width="100"/>
        <DataGridTextColumn Header="Vermögen Ende" Binding="{Binding TotalPortfolioEnd, StringFormat={}{0:N0} €}" Width="100"/>
        <DataGridTextColumn Header="Status" Binding="{Binding YearStatus}" Width="60"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Grid>
   </TabItem>

   <TabItem Header="Finanzierung der Ausgaben">
    <DataGrid x:Name="FundingGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              ColumnHeaderStyle="{StaticResource ResultColumnHeader}">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Jahr" Binding="{Binding Year}" Width="70"/>
      <DataGridTextColumn Header="Gesamtbedarf p.a." Binding="{Binding TotalAnnualNeed, StringFormat={}{0:N0} €}" Width="120"/>
      <DataGridTextColumn Header="aus Rente" Binding="{Binding FundingFromPension, StringFormat={}{0:N0} €}" Width="110"/>
      <DataGridTextColumn Header="Nettoeinkommen P2" Binding="{Binding FundingFromPerson2Income, StringFormat={}{0:N0} €}" Width="135"/>
      <DataGridTextColumn Header="aus Dividenden" Binding="{Binding FundingFromDividends, StringFormat={}{0:N0} €}" Width="125"/>
      <DataGridTextColumn Header="sonstige Einnahmen" Binding="{Binding FundingFromOtherIncome, StringFormat={}{0:N0} €}" Width="135"/>
      <DataGridTextColumn Header="aus Vermögen" Binding="{Binding FundingFromCapital, StringFormat={}{0:N0} €}" Width="120"/>
      <DataGridTextColumn Header="Finanzierungslücke" Binding="{Binding FundingGap, StringFormat={}{0:N0} €}" Width="130"/>
      <DataGridTextColumn Header="Kapitalsteuer" Binding="{Binding TaxesOnCapital, StringFormat={}{0:N0} €}" Width="110"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>

   <TabItem Header="Anlageklassen">
    <DataGrid x:Name="AssetGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              ColumnHeaderStyle="{StaticResource ResultColumnHeader}">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Jahr" Binding="{Binding Year}" Width="70"/>
      <DataGridTextColumn Header="Tages/Festgeld" Binding="{Binding CashEnd, StringFormat={}{0:N0} €}" Width="120"/>
      <DataGridTextColumn Header="Welt-ETF" Binding="{Binding WorldEtfEnd, StringFormat={}{0:N0} €}" Width="120"/>
      <DataGridTextColumn Header="Dividenden-ETF" Binding="{Binding DividendEtfEnd, StringFormat={}{0:N0} €}" Width="120"/>
      <DataGridTextColumn Header="Dividenden-Aktien" Binding="{Binding DividendStocksEnd, StringFormat={}{0:N0} €}" Width="130"/>
      <DataGridTextColumn Header="Zins Tages/Festgeld" Binding="{Binding CashReturnContribution, StringFormat={}{0:N0} €}" Width="135"/>
      <DataGridTextColumn Header="Zins netto" Binding="{Binding CashNetIncome, StringFormat={}{0:N0} €}" Width="105"/>
      <DataGridTextColumn Header="Welt-ETF Kurs" Binding="{Binding WorldPriceReturnContribution, StringFormat={}{0:N0} €}" Width="115"/>
      <DataGridTextColumn Header="Welt-ETF Ausschüttung" Binding="{Binding WorldDistributionContribution, StringFormat={}{0:N0} €}" Width="145"/>
      <DataGridTextColumn Header="Welt-ETF Ausschüttung netto" Binding="{Binding WorldNetIncome, StringFormat={}{0:N0} €}" Width="170"/>
      <DataGridTextColumn Header="Div.-ETF Kurs" Binding="{Binding DividendEtfPriceReturnContribution, StringFormat={}{0:N0} €}" Width="110"/>
      <DataGridTextColumn Header="Div.-ETF Ausschüttung" Binding="{Binding DividendEtfDistributionContribution, StringFormat={}{0:N0} €}" Width="140"/>
      <DataGridTextColumn Header="Div.-ETF Ausschüttung netto" Binding="{Binding DividendEtfNetIncome, StringFormat={}{0:N0} €}" Width="165"/>
      <DataGridTextColumn Header="Div.-Aktien Kurs" Binding="{Binding DividendStocksPriceReturnContribution, StringFormat={}{0:N0} €}" Width="120"/>
      <DataGridTextColumn Header="Div.-Aktien Dividende" Binding="{Binding DividendStocksDistributionContribution, StringFormat={}{0:N0} €}" Width="140"/>
      <DataGridTextColumn Header="Div.-Aktien Dividende netto" Binding="{Binding DividendStocksNetIncome, StringFormat={}{0:N0} €}" Width="165"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>

   <TabItem Header="Rücklagen / Sonderausgaben">
    <DataGrid x:Name="ReserveGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              ColumnHeaderStyle="{StaticResource ResultColumnHeader}">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Jahr" Binding="{Binding Year}" Width="70"/>
      <DataGridTextColumn Header="Haus-Instandhaltung p.a." Binding="{Binding HouseMaintenanceExpense, StringFormat={}{0:N0} €}" Width="150"/>
      <DataGridTextColumn Header="Auto-Ersatz Ausgabe" Binding="{Binding CarReplacementExpense, StringFormat={}{0:N0} €}" Width="135"/>
      <DataGridTextColumn Header="Gesundheit" Binding="{Binding HealthReserveTarget, StringFormat={}{0:N0} €}" Width="105"/>
      <DataGridTextColumn Header="Reisen" Binding="{Binding TravelReserveTarget, StringFormat={}{0:N0} €}" Width="105"/>
      <DataGridTextColumn Header="Sonstiges" Binding="{Binding OtherReserveTarget, StringFormat={}{0:N0} €}" Width="105"/>
      <DataGridTextColumn Header="Reserve Soll gesamt" Binding="{Binding ReserveTarget, StringFormat={}{0:N0} €}" Width="135"/>
      <DataGridTextColumn Header="Reserve Ist" Binding="{Binding ReserveActual, StringFormat={}{0:N0} €}" Width="110"/>
      <DataGridTextColumn Header="Status" Binding="{Binding YearStatus}" Width="80"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
  </TabControl>
  </Grid>
 </ScrollViewer>
</Window>
