<Window x:Class="RockefellerFiction.AboutWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:sys="clr-namespace:System;assembly=mscorlib"
 Title="About RockefellerFiction"
 Icon="Resources/AppIcon.ico"
 Width="620"
 Height="330"
 MaxWidth="620"
 MaxHeight="330"
 ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner"
 ShowInTaskbar="False">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Design.xaml"/>
   </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
 </Window.Resources>

 <Grid Background="{StaticResource BgBrush}" Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="22"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid Grid.Row="0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="86"/>
    <ColumnDefinition Width="18"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>

   <Ellipse Grid.Column="0"
            Width="82"
            Height="82"
            VerticalAlignment="Top"
            Stroke="{StaticResource AccentBrush}"
            StrokeThickness="2">
    <Ellipse.Fill>
     <ImageBrush ImageSource="Resources/molotov.jpg"
                 Stretch="UniformToFill"/>
    </Ellipse.Fill>
   </Ellipse>

   <StackPanel Grid.Column="2">
    <TextBlock Text="RockefellerFiction"
               FontSize="18"
               FontWeight="SemiBold"
               Foreground="{StaticResource TextBrush}"
               Margin="0,0,0,8"/>

    <TextBlock Text="Copyright © Daniel Capilla"
               Foreground="{StaticResource TextBrush}"
               Margin="0,0,0,5"/>

    <TextBlock Foreground="{StaticResource TextBrush}"
               Margin="0,0,0,5">
     <Run Text="Version: "/>
     <Run x:Name="VersionText"/>
    </TextBlock>

    <TextBlock x:Name="UpdateStatusText"
               Foreground="{StaticResource MutedTextBrush}"
               Margin="0,0,0,8"
               MouseLeftButtonUp="UpdateStatusText_MouseLeftButtonUp"/>

    <TextBlock Foreground="{StaticResource AccentBrush}">
     <Hyperlink NavigateUri="https://github.com/UncleRiot/RockefellerFiction"
                RequestNavigate="Hyperlink_RequestNavigate">
      https://github.com/UncleRiot/RockefellerFiction
     </Hyperlink>
    </TextBlock>
   </StackPanel>
  </Grid>

  <Grid Grid.Row="2">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="12"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <TextBlock Grid.Row="0"
              Text="Wenn dir das Tool hilft, kannst du die Entwicklung hier unterstützen:"
              TextWrapping="Wrap"
              Foreground="{StaticResource TextBrush}"/>

   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <Image Grid.Column="0"
           Source="Resources/ko-fi.png"
           Width="134.25"
           Height="31.5"
           Stretch="Uniform"
           VerticalAlignment="Center"/>

    <Button Grid.Column="2"
            Content="OK"
            Width="90"
            Padding="10,6"
            Style="{StaticResource SecondaryButton}"
            IsDefault="True"
            IsCancel="True"
            Click="Ok_Click"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
