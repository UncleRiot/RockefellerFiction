<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <AssemblyName>RockefellerFiction</AssemblyName>
    <RootNamespace>RockefellerFiction</RootNamespace>

    <Version>0.1.70</Version>
    <AssemblyVersion>0.1.70</AssemblyVersion>
    <FileVersion>0.1.70</FileVersion>
    <InformationalVersion>0.1.70</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources\AppIcon.png" />
    <Resource Include="Resources\AppIcon.ico" />
    <Resource Include="Resources\Help.png" />
    <Resource Include="Resources\ko-fi.png" />
    <Resource Include="Resources\molotov.jpg" />
  </ItemGroup>
</Project>
